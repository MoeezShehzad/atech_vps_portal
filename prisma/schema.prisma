generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  userId        Int       @id @default(autoincrement()) @map("user_id")
  fullName      String    @map("full_name") @db.VarChar(100)
  email         String    @unique(map: "uq_users_email") @db.VarChar(255)
  passwordHash  String?   @map("password_hash") @db.VarChar(255)
  phone         String?   @db.VarChar(30)
  address       String?   @db.VarChar(255)
  city          String?   @db.VarChar(100)
  postalCode    String?   @map("postal_code") @db.VarChar(20)
  country       String?   @db.VarChar(100)
  googleId      String?   @unique(map: "uq_users_google_id") @map("google_id") @db.VarChar(255)
  provider      String    @default("LOCAL") @map("provider") @db.VarChar(20)
  avatar_url    String?   @db.NVarChar(Max)
  isActive      Boolean   @default(true) @map("is_active")
  emailVerified Boolean   @default(false) @map("email_verified")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  userRoles       UserRole[]
  subscriptions   Subscription[]
  virtualMachines VirtualMachine[]
  invoices        Invoice[]
  payments        Payment[]
  securityLogs    SecurityLog[]
  activityLogs    ActivityLog[]
  refreshTokens   RefreshToken[]
  sshKeys         SSHKey[]

  @@map("Users")
}

model Role {
  roleId      Int      @id @default(autoincrement()) @map("role_id")
  roleName    String   @unique(map: "uq_roles_name") @map("role_name") @db.VarChar(50)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  userRoles UserRole[]

  @@map("Roles")
}

model UserRole {
  userId     Int      @map("user_id")
  roleId     Int      @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [roleId], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("User_Roles")
}

model VPSPlan {
  planId          Int      @id @default(autoincrement()) @map("plan_id")
  name            String   @unique(map: "uq_vps_plans_name") @db.VarChar(50)
  description     String?  @db.VarChar(500)
  cpuCores        Int      @map("cpu_cores")
  ramGb           Int      @map("ram_gb")
  storageGb       Int      @map("storage_gb")
  storageType     String   @map("storage_type") @db.VarChar(20)
  bandwidthMbps   Int      @map("bandwidth_mbps")
  ipv4Addresses   Int      @default(1) @map("ipv4_addresses")
  backupEnabled   Boolean  @default(false) @map("backup_enabled")
  snapshotEnabled Boolean  @default(true) @map("snapshot_enabled")
  maxSnapshots    Int?     @map("max_snapshots")
  monthlyPrice    Decimal  @map("monthly_price") @db.Decimal(10, 2)
  currency        String   @default("USD") @db.Char(3)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  subscriptions   Subscription[]
  virtualMachines VirtualMachine[]

  @@map("VPS_Plans")
}

model OSImage {
  imageId      Int      @id @default(autoincrement()) @map("image_id")
  name         String   @db.VarChar(100)
  osFamily     String   @map("os_family") @db.VarChar(30)
  version      String   @db.VarChar(50)
  templatePath String   @map("template_path") @db.VarChar(500)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  virtualMachines VirtualMachine[]

  @@map("OS_Images")
}

model HyperVHost {
  hostId    Int      @id @default(autoincrement()) @map("host_id")
  hostname  String   @unique(map: "uq_hyperv_hosts_hostname") @db.VarChar(100)
  ipAddress String   @map("ip_address") @db.VarChar(45)
  status    String   @db.VarChar(20)
  location  String?  @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  virtualMachines VirtualMachine[]

  @@map("HyperV_Hosts")
}

model Subscription {
  subscriptionId  Int       @id @default(autoincrement()) @map("subscription_id")
  userId          Int       @map("user_id")
  planId          Int       @map("plan_id")
  status          String    @db.VarChar(30)
  startDate       DateTime  @map("start_date")
  nextBillingDate DateTime? @map("next_billing_date")
  endDate         DateTime? @map("end_date")
  monthlyPrice    Decimal   @map("monthly_price") @db.Decimal(10, 2)
  currency        String    @db.Char(3)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [userId])
  plan            VPSPlan          @relation(fields: [planId], references: [planId])
  virtualMachines VirtualMachine[]
  invoices        Invoice[]

  @@map("Subscriptions")
}

model VirtualMachine {
  vmId               Int       @id @default(autoincrement()) @map("vm_id")
  userId             Int       @map("user_id")
  subscriptionId     Int       @map("subscription_id")
  planId             Int       @map("plan_id")
  imageId            Int       @map("image_id")
  hostId             Int       @map("host_id")
  vmName             String    @map("vm_name") @db.VarChar(100)
  hostname           String?   @db.VarChar(100)
  hypervVmId         String?   @unique(map: "uq_virtual_machines_hyperv_id") @map("hyperv_vm_id") @db.VarChar(100)
  cpuCores           Int       @map("cpu_cores")
  ramGb              Int       @map("ram_gb")
  storageGb          Int       @map("storage_gb")
  status             String    @db.VarChar(30)
  provisioningStatus String    @map("provisioning_status") @db.VarChar(30)
  provisioningError  String?   @map("provisioning_error") @db.NVarChar(Max)
  adminUser          String?   @default("ubuntu") @map("admin_user") @db.VarChar(50)
  adminPassword      String?   @map("admin_password") @db.VarChar(100)
  createdAt          DateTime  @default(now()) @map("created_at")
  startedAt          DateTime? @map("started_at")
  stoppedAt          DateTime? @map("stopped_at")
  terminatedAt       DateTime? @map("terminated_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [userId], onUpdate: NoAction, onDelete: NoAction)
  subscription     Subscription      @relation(fields: [subscriptionId], references: [subscriptionId], onUpdate: NoAction, onDelete: NoAction)
  plan             VPSPlan           @relation(fields: [planId], references: [planId], onUpdate: NoAction, onDelete: NoAction)
  image            OSImage           @relation(fields: [imageId], references: [imageId], onUpdate: NoAction, onDelete: NoAction)
  host             HyperVHost        @relation(fields: [hostId], references: [hostId], onUpdate: NoAction, onDelete: NoAction)
  ipPool           IPPool[]
  snapshots        VMSnapshot[]
  backups          Backup[]
  provisioningJobs ProvisioningJob[]
  activityLogs     ActivityLog[]

  @@map("VirtualMachines")
}

model IPPool {
  ipId         Int      @id @default(autoincrement()) @map("ip_id")
  ipAddress    String   @unique(map: "uq_ip_pool_address") @map("ip_address") @db.VarChar(45)
  subnetMask   String   @map("subnet_mask") @db.VarChar(45)
  gateway      String   @db.VarChar(45)
  ipType       String   @map("ip_type") @db.VarChar(20)
  status       String   @db.VarChar(20)
  assignedVmId Int?     @map("assigned_vm_id")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  assignedVm VirtualMachine? @relation(fields: [assignedVmId], references: [vmId], onUpdate: NoAction, onDelete: NoAction)

  @@map("IP_Pool")
}

model VMSnapshot {
  snapshotId  Int       @id @default(autoincrement()) @map("snapshot_id")
  vmId        Int       @map("vm_id")
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(500)
  status      String    @db.VarChar(20)
  createdAt   DateTime  @default(now())
  deletedAt   DateTime? @map("deleted_at")

  vm VirtualMachine @relation(fields: [vmId], references: [vmId])

  @@map("VM_Snapshots")
}

model Backup {
  backupId       BigInt    @id @default(autoincrement()) @map("backup_id")
  vmId           Int       @map("vm_id")
  backupType     String    @map("backup_type") @db.VarChar(20)
  backupLocation String    @map("backup_location") @db.VarChar(500)
  backupSizeGb   Decimal?  @map("backup_size_gb") @db.Decimal(12, 2)
  status         String    @db.VarChar(20)
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now())

  vm VirtualMachine @relation(fields: [vmId], references: [vmId])

  @@map("Backups")
}

model ProvisioningJob {
  jobId        BigInt    @id @default(autoincrement()) @map("job_id")
  vmId         Int       @map("vm_id")
  jobType      String    @map("job_type") @db.VarChar(30)
  status       String    @db.VarChar(20)
  currentStep  String?   @map("current_step") @db.VarChar(100)
  errorMessage String?   @map("error_message") @db.NVarChar(Max)
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now())

  vm VirtualMachine @relation(fields: [vmId], references: [vmId])

  @@map("Provisioning_Jobs")
}

model Invoice {
  invoiceId      BigInt    @id @default(autoincrement()) @map("invoice_id")
  userId         Int       @map("user_id")
  subscriptionId Int       @map("subscription_id")
  invoiceNumber  String    @unique(map: "uq_invoices_number") @map("invoice_number") @db.VarChar(50)
  subtotal       Decimal   @db.Decimal(10, 2)
  tax            Decimal   @default(0) @db.Decimal(10, 2)
  discount       Decimal   @default(0) @db.Decimal(10, 2)
  total          Decimal   @db.Decimal(10, 2)
  currency       String    @db.Char(3)
  status         String    @db.VarChar(20)
  issueDate      DateTime  @map("issue_date")
  dueDate        DateTime? @map("due_date")
  paidDate       DateTime? @map("paid_date")
  createdAt      DateTime  @default(now())

  user         User         @relation(fields: [userId], references: [userId], onUpdate: NoAction, onDelete: NoAction)
  subscription Subscription @relation(fields: [subscriptionId], references: [subscriptionId], onUpdate: NoAction, onDelete: NoAction)
  payments     Payment[]

  @@map("Invoices")
}

model Payment {
  paymentId      BigInt    @id @default(autoincrement()) @map("payment_id")
  userId         Int       @map("user_id")
  invoiceId      BigInt    @map("invoice_id")
  paymentGateway String    @map("payment_gateway") @db.VarChar(50)
  transactionId  String    @unique(map: "uq_payments_transaction") @map("transaction_id") @db.VarChar(255)
  amount         Decimal   @db.Decimal(10, 2)
  currency       String    @db.Char(3)
  status         String    @db.VarChar(20)
  paymentDate    DateTime? @map("payment_date")
  createdAt      DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [userId], onUpdate: NoAction, onDelete: NoAction)
  invoice Invoice @relation(fields: [invoiceId], references: [invoiceId], onUpdate: NoAction, onDelete: NoAction)

  @@map("Payments")
}

model SecurityLog {
  logId     BigInt   @id @default(autoincrement()) @map("log_id")
  userId    Int?     @map("user_id")
  action    String   @db.VarChar(100)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  result    String   @db.VarChar(20)
  details   String?  @db.NVarChar(Max)
  timestamp DateTime @default(now())

  user User? @relation(fields: [userId], references: [userId], onUpdate: NoAction, onDelete: NoAction)

  @@map("Security_Logs")
}

model ActivityLog {
  activityId BigInt   @id @default(autoincrement()) @map("activity_id")
  userId     Int?     @map("user_id")
  vmId       Int?     @map("vm_id")
  action     String   @db.VarChar(100)
  status     String   @db.VarChar(20)
  details    String?  @db.NVarChar(Max)
  createdAt  DateTime @default(now())

  user User?           @relation(fields: [userId], references: [userId], onUpdate: NoAction, onDelete: NoAction)
  vm   VirtualMachine? @relation(fields: [vmId], references: [vmId], onUpdate: NoAction, onDelete: NoAction)

  @@map("Activity_Logs")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique(map: "uq_refresh_token") @db.VarChar(500)
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId], map: "idx_refresh_token_user_id")
  @@map("Refresh_Tokens")
}

model SSHKey {
  keyId       Int      @id @default(autoincrement()) @map("key_id")
  userId      Int      @map("user_id")
  name        String   @db.VarChar(100)
  publicKey   String   @map("public_key") @db.NVarChar(Max)
  fingerprint String   @db.VarChar(100)
  keyType     String   @default("ED25519") @map("key_type") @db.VarChar(30)
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("SSH_Keys")
}