# Server Configuration
PORT=5000
DATABASE_URL="sqlserver://localhost:1433;database=atech_vps_db;user=atech_portal_user;password=YOUR_PASSWORD;encrypt=true;trustServerCertificate=true"

JWT_SECRET="your_jwt_secret"
JWT_VERIFY_SECRET="your_jwt_verify_secret"

# Google OAuth Configuration
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
SESSION_SECRET="your_session_secret"

# Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS="your_app_password"
SMTP_FROM="ATC Data Center <your_email@gmail.com>"

# App URLs
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5174
